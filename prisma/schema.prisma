generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bairro {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  lat       Float?
  lng       Float?
  zoom      Int      @default(15)
  agendaColeta AgendaColeta[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Veiculo {
  id               Int      @id @default(autoincrement())
  nome             String
  tipoResiduo      String   @default("comum") // comum, reciclavel, organico
  placa            String?
  lat              Float    @default(-29.7547)
  lng              Float    @default(-57.0829)
  ultimaAtualizacao DateTime @default(now())
  ativo            Boolean  @default(true)
  posicoes         PosicaoVeiculo[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PosicaoVeiculo {
  id        Int      @id @default(autoincrement())
  veiculoId Int
  veiculo   Veiculo  @relation(fields: [veiculoId], references: [id])
  lat       Float
  lng       Float
  timestamp DateTime @default(now())
}

model AgendaColeta {
  id          Int     @id @default(autoincrement())
  bairroId    Int
  bairro      Bairro  @relation(fields: [bairroId], references: [id])
  diaSemana   Int     // 0=domingo, 1=segunda, ..., 6=sabado
  turno       String  @default("manha") // manha, tarde
  tipoResiduo String  @default("comum")
  horarioInicio String?
  horarioFim   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bairroId])
}

model Relato {
  id          Int      @id @default(autoincrement())
  nome        String?
  email       String?
  descricao   String
  tipoProblema String   @default("entulho") // entulho, coleta_nao_realizada, outro
  fotoUrl     String?
  lat         Float?
  lng         Float?
  bairroId    Int?
  status      String   @default("pendente") // pendente, em_analise, resolvido
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}
